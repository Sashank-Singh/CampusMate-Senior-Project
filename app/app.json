{
  "expo": {
    "name": "CampusMate",
    "slug": "campusmate",
    "version": "1.0.0",
    "description": "A comprehensive campus management application for CSU",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "campusmate",
    "entryPoint": "./App.tsx",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.campusmate.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs camera access to upload your schedule.",
        "NSPhotoLibraryUsageDescription": "This app needs photo library access to upload your schedule.",
        "NSLocationWhenInUseUsageDescription": "This app needs access to your location for campus navigation.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app needs access to your location for campus navigation.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "campusmate"
            ]
          }
        ],
        "UIBackgroundModes": ["location", "fetch"]
      },
      "config": {
        "googleMapsApiKey": "AIzaSyDzoRCeNKfH2aQcDkiVpSZC4S4NbJzToDM"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "campusmate"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDzoRCeNKfH2aQcDkiVpSZC4S4NbJzToDM"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "EXPO_PUBLIC_NEON_API_URL": "process.env.EXPO_PUBLIC_NEON_API_URL",
      "EXPO_PUBLIC_NEON_USERNAME": "process.env.EXPO_PUBLIC_NEON_USERNAME",
      "EXPO_PUBLIC_NEON_PASSWORD": "process.env.EXPO_PUBLIC_NEON_PASSWORD",
      "apiUrl": "https://openrouter.ai/api/v1/chat/completions",
      "blackboardConfig": {
        "domain": "YOUR_SCHOOL_DOMAIN.blackboard.com",
        "clientId": "YOUR_CLIENT_ID",
        "callbackUrl": "campusmate://auth/callback"
      },
      "eas": {
        "projectId": "238e8131-a854-44cd-9cc7-f97c3273b809"
      },
      "EXPO_PUBLIC_OPENROUTER_API_KEY": "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"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CampusMate to access your camera to use the AR Navigator"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow CampusMate to use your location for campus navigation"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow CampusMate to use Face ID for secure authentication"
        }
      ]
    ],
    "platforms": [
      "ios",
      "android"
    ],
    "newArchEnabled": false
  },
  "build": {
    "production": {
      "distribution": "store",
      "ios": {
        "providerId": "apple",
        "buildConfiguration": "Release"
      }
    }
  }
}
