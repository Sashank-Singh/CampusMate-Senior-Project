{
  "expo": {
    "name": "CampusMate",
    "slug": "campusmate",
    "version": "1.0.0",
    "description": "A comprehensive campus management application for CSU",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "campusmate",
    "entryPoint": "./App.tsx",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.campusmate.app",
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs camera access to upload your schedule.",
        "NSPhotoLibraryUsageDescription": "This app needs photo library access to upload your schedule."
      },
      "config": {
        "googleMapsApiKey": "AIzaSyDzoRCeNKfH2aQcDkiVpSZC4S4NbJzToDM"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDzoRCeNKfH2aQcDkiVpSZC4S4NbJzToDM"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "EXPO_PUBLIC_NEON_API_URL": "process.env.EXPO_PUBLIC_NEON_API_URL",
      "EXPO_PUBLIC_NEON_USERNAME": "process.env.EXPO_PUBLIC_NEON_USERNAME",
      "EXPO_PUBLIC_NEON_PASSWORD": "process.env.EXPO_PUBLIC_NEON_PASSWORD",
      "apiUrl": "https://openrouter.ai/api/v1/chat/completions"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CampusMate to access your camera to use the AR Navigator"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow CampusMate to use your location for campus navigation"
        }
      ]
    ],
    "platforms": [
      "ios",
      "android"
    ],

    "newArchEnabled": true
  }
}