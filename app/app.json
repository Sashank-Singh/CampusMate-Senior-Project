{
  "expo": {
    "name": "CampusMate",
    "slug": "campusmate",
    "version": "1.0.0",
    "description": "A comprehensive campus management application for CSU",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "campusmate",
    "entryPoint": "./App.tsx",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.campusmate.app",
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs camera access to upload your schedule.",
        "NSPhotoLibraryUsageDescription": "This app needs photo library access to upload your schedule."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "DATABASE_URL": "postgresql://CampusMate_owner:npg_xgO48UVpqcSk@ep-dry-tooth-a5dza69l-pooler.us-east-2.aws.neon.tech/CampusMate?sslmode=require",
      "apiUrl": "https://openrouter.ai/api/v1/chat/completions"
    },
    "plugins": [
      "expo-font"
    ],
    "platforms": [
      "ios",
      "android"
    ],

    "newArchEnabled": true
  }
}